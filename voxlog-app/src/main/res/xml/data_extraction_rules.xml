<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer. Secrets live in no_backup/ and are never included; models are re-downloadable. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="voxlog.db" />
        <include domain="file" path="audio/" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="voxlog.db" />
        <include domain="file" path="audio/" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
